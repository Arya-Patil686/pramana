# ─────────────────────────────────────────────────────────────────────────────
# PRAMĀNA — Google AI and upstream data credentials
#
# Every value here is optional. With none of them set the application runs the
# complete end-to-end flow against recorded model output, and every surface
# says which capability is recorded rather than live. Adding a key switches
# that capability over on the next request — no rebuild, no redeploy.
#
# Copy to .env.local and fill in what you have:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# Gemini — multimodal vision (citizen photo analysis) and structured reasoning
# (operator advisory, cross-border notice). One key covers both.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Maps Platform — the Air Quality API (receptor readings and the
# incumbent forecast baseline) and Geocoding (placing a report in a tehsil).
# Enable both APIs on the key at https://console.cloud.google.com/apis
GOOGLE_MAPS_API_KEY=

# Cloud Translation — renders the generated advisory narrative.
GOOGLE_TRANSLATE_API_KEY=

# Cloud Text-to-Speech — speaks the reviewed public-health message.
GOOGLE_TTS_API_KEY=

# Cloud Speech-to-Text — accepts a spoken citizen report.
GOOGLE_STT_API_KEY=

# A single key stands in for any GOOGLE_* variable above that is left unset,
# which is usually what you want when one Cloud project has every API enabled.
GOOGLE_API_KEY=

# NASA FIRMS — VIIRS 375 m active fire detections. Free, issued instantly at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Model overrides. Leave unset unless your project has different quota.
# PRAMANA_GEMINI_VISION_MODEL=gemini-2.5-flash
# PRAMANA_GEMINI_REASONING_MODEL=gemini-2.5-flash

# No key is needed for the 925 hPa wind field. Open-Meteo is called live on
# every deployment, which is why the transport model is wired to it.

# Vertex AI. Setting this routes every Gemini call through Vertex in that
# project, authenticating as the runtime service account instead of a key —
# which is the only form a ministry deployment can take. Leave unset to use
# the Gemini API with GEMINI_API_KEY above.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# CPCB continuous ambient monitoring, via the Open Government Data platform.
# This is the reference network an Indian regulator is statutorily required to
# act on. Free, issued instantly at https://data.gov.in/user/register
DATA_GOV_IN_API_KEY=
